#!/usr/bin/python3 -I
"""Restricted SSH receiver for atomic MBBB content releases.

Accepts legacy protocol 1 (gigs/testimonials) and protocol 2 (adds gallery).
Protocol 2 images are strict base64 with allowlisted names and signature checks.
YAML validation and full image processing belong in the build step.
"""
import base64
import binascii
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import sys
import tempfile
import time

ROOT = Path('/home/dcshosting/mbbb-content')
MAX_UPLOAD = 32 * 1024 * 1024
MAX_IMAGE = 5 * 1024 * 1024
MAX_FILE = 512 * 1024
PATTERNS = {
    'gigs': re.compile(r'[A-Za-z0-9][A-Za-z0-9_-]*\.ya?ml', re.I),
    'testimonials': re.compile(r'[A-Za-z0-9][A-Za-z0-9_ &-]*\.ya?ml', re.I),
}


def require(condition, message):
    if not condition:
        raise ValueError(message)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, 'Duplicate JSON key')
        result[key] = value
    return result


def parse_json(text):
    return json.loads(text, object_pairs_hook=unique_object)


def validate(raw):
    require(len(raw) <= MAX_UPLOAD, 'Upload exceeds 32 MiB')
    bundle = parse_json(raw.decode('utf-8'))
    require(isinstance(bundle, dict), 'Expected a JSON object')
    version = bundle.get('version')
    require(type(version) is int and version in (1, 2), 'Unsupported version')
    keys = {'version', 'commit', 'sequence', 'files'}
    if version == 2:
        keys.add('images')
    require(set(bundle) == keys, 'Unexpected bundle fields')
    require(isinstance(bundle['commit'], str) and re.fullmatch(r'[0-9a-f]{40}', bundle['commit']), 'Invalid commit')
    require(type(bundle['sequence']) is int and 0 < bundle['sequence'] < 10**15, 'Invalid sequence')
    files = bundle['files']
    require(isinstance(files, dict) and 2 <= len(files) <= 2003, 'Invalid file count')
    expected = set()
    for collection, pattern in PATTERNS.items():
        manifest = f'{collection}/{collection}.json'
        require(manifest in files and isinstance(files[manifest], str), 'Missing manifest: ' + manifest)
        names = parse_json(files[manifest])
        require(isinstance(names, list) and len(names) <= 1000, 'Invalid manifest')
        seen = set()
        anchors = set()
        expected.add(manifest)
        for name in names:
            require(isinstance(name, str) and len(name) <= 200 and pattern.fullmatch(name), 'Invalid YAML filename')
            anchor = name.rsplit('.', 1)[0]
            require(name not in seen and anchor not in anchors, 'Duplicate filename or anchor')
            seen.add(name)
            anchors.add(anchor)
            expected.add(f'{collection}/{name}')
    if version == 2:
        manifest = 'gallery/photos.json'
        require(manifest in files and isinstance(files[manifest], str), 'Missing gallery manifest')
        expected.add(manifest)
        photos = parse_json(files[manifest])
        require(isinstance(photos, list) and len(photos) <= 1000, 'Invalid gallery manifest')
        images = bundle['images']
        require(isinstance(images, dict) and len(images) <= 1000, 'Invalid images object')
        expected_images = set()
        for photo in photos:
            require(isinstance(photo, dict), 'Invalid photo record')
            require(set(photo) == {'title', 'file', 'alt', 'caption', 'photographer', 'use_on_homepage', 'published'}, 'Unexpected photo fields')
            for field in ('title', 'alt'):
                require(isinstance(photo[field], str) and photo[field].strip() and len(photo[field]) <= 8000, 'Missing or invalid photo ' + field)
            for field in ('caption', 'photographer'):
                require(isinstance(photo[field], str) and len(photo[field]) <= 8000, 'Invalid photo ' + field)
            require(photo['published'] is True, 'Gallery contains an unpublished photo')
            require(type(photo['use_on_homepage']) is bool, 'Invalid homepage flag')
            name = photo['file']
            require(isinstance(name, str) and len(name) <= 200 and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*\.(?:jpe?g|png|webp)', name, re.I), 'Invalid image filename')
            expected_images.add('assets/gallery/' + name)
        require(set(images) == expected_images, 'Images must exactly match gallery manifest')
        for name, encoded in images.items():
            require(isinstance(encoded, str) and len(encoded) <= 4 * ((MAX_IMAGE + 2) // 3), 'Invalid image encoding size')
            try:
                data = base64.b64decode(encoded, validate=True)
            except (ValueError, binascii.Error):
                raise ValueError('Invalid base64 image') from None
            require(0 < len(data) <= MAX_IMAGE, 'Image exceeds 5 MiB or is empty')
            suffix = name.rsplit('.', 1)[1].lower()
            signature_ok = (
                (suffix in ('jpg', 'jpeg') and data.startswith(b'\xff\xd8\xff')) or
                (suffix == 'png' and data.startswith(b'\x89PNG\r\n\x1a\n')) or
                (suffix == 'webp' and len(data) >= 12 and data[:4] == b'RIFF' and data[8:12] == b'WEBP')
            )
            require(signature_ok, 'Image signature does not match filename: ' + name)
    require(set(files) == expected, 'Text files must exactly match manifests')
    for name, content in files.items():
        require(isinstance(content, str) and content.strip() and '\x00' not in content, 'Invalid file text: ' + name)
        require(len(content.encode('utf-8')) <= MAX_FILE, 'File exceeds 512 KiB: ' + name)
    digest_source = files if version == 1 else {'files': files, 'images': bundle['images']}
    canonical = json.dumps(digest_source, sort_keys=True, ensure_ascii=True, separators=(',', ':')).encode('ascii')
    digest = hashlib.sha256(canonical).hexdigest()
    return bundle, digest


def publish(raw, root=ROOT):
    bundle, digest = validate(raw)
    require(root.is_dir(), 'Content directory does not exist')
    with (root / '.publish.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        releases = root / 'releases'
        releases.mkdir(mode=0o755, exist_ok=True)
        current = root / 'current'
        if current.is_symlink():
            old = parse_json((current / 'release.json').read_text(encoding='utf-8'))
            require(bundle['sequence'] >= old['sequence'], 'Older publication rejected')
            if bundle['sequence'] == old['sequence']:
                require(bundle['commit'] == old['commit'] and digest == old['digest'], 'Sequence already used for different content')
                return 'Already published: ' + old['release']
        else:
            require(not current.exists(), 'Current path must be a symlink')
        release = f"{bundle['sequence']}-{bundle['commit']}"
        destination = releases / release
        metadata = {'release': release, 'commit': bundle['commit'], 'sequence': bundle['sequence'], 'digest': digest}
        stage = Path(tempfile.mkdtemp(prefix='.upload-', dir=root))
        pointer = stage / 'current-link'
        try:
            # All paths were allowlisted before creating public files.
            payloads = {name: text.encode('utf-8') for name, text in bundle['files'].items()}
            payloads.update({name: base64.b64decode(encoded, validate=True)
                             for name, encoded in bundle.get('images', {}).items()})
            for name, content in payloads.items():
                target = stage / name
                target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
                with target.open('xb') as output:
                    output.write(content)
                    output.flush()
                    os.fsync(output.fileno())
                target.chmod(0o644)
            (stage / 'release.json').write_text(json.dumps(metadata) + '\n', encoding='utf-8')
            (stage / 'release.json').chmod(0o644)
            if destination.exists():
                # A completed upload may remain after interruption before activation.
                require(not destination.is_symlink(), 'Invalid release directory')
                require(parse_json((destination / 'release.json').read_text()) == metadata, 'Release already exists with different content')
                for name, content in payloads.items():
                    require((destination / name).read_bytes() == content, 'Existing release is incomplete')
            else:
                stage.chmod(0o755)
                stage.rename(destination)
                stage = Path(tempfile.mkdtemp(prefix='.activate-', dir=root))
                pointer = stage / 'current-link'
            pointer.symlink_to('releases/' + release)
            # One rename switches all content together. Retain old releases.
            os.replace(pointer, current)
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        return 'Published: ' + release


def cleanup(expected=None, dry_run=False, root=ROOT, now=None):
    """Keep active, five newest, and all releases younger than seven days."""
    require(root.is_dir(), 'Content directory does not exist')
    pattern = re.compile(r'[1-9]\d*-[a-f0-9]{40}')
    with (root / '.publish.lock').open('a') as lock:
        # Share the publication lock so activation cannot race deletion.
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        releases = root / 'releases'
        require(releases.is_dir() and not releases.is_symlink(), 'Invalid releases directory')
        current = root / 'current'
        require(current.is_symlink(), 'Current path must be a symlink')
        active = current.resolve(strict=True)
        require(active.parent == releases.resolve() and pattern.fullmatch(active.name),
                'Current release is outside the releases directory')
        metadata = parse_json((active / 'release.json').read_text(encoding='utf-8'))
        require(metadata.get('release') == active.name, 'Current release metadata mismatch')
        if expected is not None:
            require(expected == active.name, 'Active release changed; cleanup skipped')
        candidates = [entry for entry in releases.iterdir()
                      if pattern.fullmatch(entry.name)
                      and not entry.is_symlink() and entry.is_dir()]
        candidates.sort(key=lambda entry: int(entry.name.split('-', 1)[0]), reverse=True)
        protected = {entry.name for entry in candidates[:5]} | {active.name}
        cutoff = (time.time() if now is None else now) - 7 * 24 * 60 * 60
        removed = 0
        for entry in candidates:
            # Directory mtime records when the release was assembled on this server.
            if entry.name in protected or entry.stat().st_mtime >= cutoff:
                continue
            if dry_run:
                print('Would remove: ' + entry.name)
            else:
                shutil.rmtree(entry)
                print('Removed: ' + entry.name)
            removed += 1
        return f"Cleanup {'preview' if dry_run else 'complete'}: {removed} releases {'eligible' if dry_run else 'removed'}; active release protected: {active.name}"


def main():
    os.umask(0o022)
    signal.alarm(120)
    command = os.environ.get('SSH_ORIGINAL_COMMAND', '')
    if command == 'check':
        require(ROOT.is_dir() and os.access(ROOT, os.W_OK | os.X_OK), 'Content directory is not writable')
        print('MBBB content receiver ready (protocols 1 and 2). No content changed.')
    elif command == 'publish':
        print(publish(sys.stdin.buffer.read(MAX_UPLOAD + 1)))
    elif command == 'cleanup-preview':
        print(cleanup(dry_run=True))
    elif command.startswith('cleanup '):
        expected = command.removeprefix('cleanup ')
        require(re.fullmatch(r'[1-9]\d*-[a-f0-9]{40}', expected), 'Invalid cleanup release')
        print(cleanup(expected=expected))
    else:
        raise ValueError('Only check, publish, cleanup-preview and cleanup RELEASE commands are allowed')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError) as error:
        print('Publication rejected: ' + str(error), file=sys.stderr)
        sys.exit(1)

